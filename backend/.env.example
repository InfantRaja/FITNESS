# FitTrack Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or Local MongoDB)
# Example Atlas URI: mongodb+srv://<user>:<password>@cluster0.mongodb.net/fittrack?retryWrites=true&w=majority
# Example Local URI: mongodb://127.0.0.1:27017/fittrack
MONGO_URI=mongodb://127.0.0.1:27017/fittrack

# JWT Secret & Expiry
JWT_SECRET=fittrack_super_secure_jwt_secret_key_2026_dev
JWT_EXPIRE=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5500

# Google Gemini AI API Key (Optional: Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
